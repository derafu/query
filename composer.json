{
    "name": "derafu/query",
    "description": "Derafu: Query - Expressive Path-Based Query Builder for PHP",
    "type": "library",
    "homepage": "https://www.derafu.dev/docs/data/query",
    "license": "MIT",
    "authors": [
        {
            "name": "Esteban De La Fuente Rubio / Derafu",
            "homepage": "https://www.derafu.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/derafu/query/issues",
        "source": "https://github.com/derafu/query"
    },
    "autoload": {
        "psr-4": {
            "Derafu\\Query\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Derafu\\TestsQuery\\": "tests/src/"
        }
    },
    "require": {
       "php": "^8.5",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^11.5",
        "doctrine/dbal": "^4.4",
        "doctrine/orm": "^3.6",
        "illuminate/database": "^13.7",
        "api-platform/core": "^4.3"
    },
    "suggest": {
        "doctrine/dbal": "Required to use the Doctrine DBAL SQL engine (DoctrineEngine).",
        "doctrine/orm": "Required to use the Doctrine ORM bridge (DoctrineQueryBuilderConditionApplier).",
        "illuminate/database": "Required to use the Eloquent bridge (IlluminateQueryBuilderConditionApplier).",
        "api-platform/core": "Required to use the API Platform custom filters."
    },
    "scripts": {
        "docs": "php tools/phpdocumentor run --config=phpdoc.xml",
        "tests": "XDEBUG_MODE=coverage vendor/bin/phpunit --configuration=phpunit.xml",
        "phpcs-fix": "vendor/bin/php-cs-fixer fix -v --config=php-cs-fixer.php",
        "phpcs": "vendor/bin/php-cs-fixer fix -v --dry-run --diff --config=php-cs-fixer.php",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
        "phpstan-export": "vendor/bin/phpstan analyse --configuration=phpstan.neon --level 9 --generate-baseline",
        "build": "npm run build"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
